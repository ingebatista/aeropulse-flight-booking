# Valores para desarrollo local.
WEB_PORT=8080
DB_NAME=flights
DB_OWNER=flights_owner
DB_OWNER_PASSWORD=flights_owner_dev
APP_DB_PASSWORD=app_dev
APP_NODE_ENV=development
ADMIN_TOKEN=aeropulse-admin-dev
HOLD_TTL_SECONDS=300

# Límites de solicitudes por minuto, por ruta y por IP (opcionales; estos son los valores por defecto).
# RATE_LIMIT_GLOBAL=120
# RATE_LIMIT_HOLD=30
# RATE_LIMIT_CONFIRM=10
# RATE_LIMIT_ADMIN=30

# Para PostgreSQL externo, configurar las URLs de cada rol.
# DATABASE_URL=postgres://app:app_dev@127.0.0.1:5433/flights
# MIGRATION_DATABASE_URL=postgres://flights_owner:flights_owner_dev@127.0.0.1:5433/flights
